BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
COURIER_IDS=

# Neon.tech (free PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash (free Redis) — use rediss:// for TLS
REDIS_URL=rediss://default:password@xxx.upstash.io:6379

YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Render: set this to your actual Render URL after first deploy
# e.g. https://shaurma-bot.onrender.com
WEBHOOK_URL=https://your-app.onrender.com
WEBHOOK_PATH=/webhook/bot
# PORT is injected automatically by Render — do NOT set it here
WEBHOOK_PORT=8080

YANDEX_TAXI_API_KEY=your_yandex_taxi_api_key
YANDEX_TAXI_CLIENT_ID=your_client_id
YANDEX_TAXI_PARK_ID=your_park_id

RESTAURANT_NAME=Shaurma House
RESTAURANT_ADDRESS=Москва, ул. Примерная, 1
RESTAURANT_LAT=55.7558
RESTAURANT_LON=37.6176
RESTAURANT_PHONE=+7XXXXXXXXXX

BONUS_RATE=5
BONUS_EXPIRE_DAYS=90
MAX_BONUS_PERCENT=30

LOG_LEVEL=INFO
